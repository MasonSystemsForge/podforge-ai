# PodForge AI environment template
# Copy this file to .env for local development.
# Never commit real credentials.

# App
VITE_APP_NAME="PodForge AI"
VITE_APP_ENV="development"

# Backend
VITE_API_URL=""

# Provider connection placeholders
VITE_VIDEO_PROVIDER_TOKEN="replace-with-local-value"
VITE_VOICE_PROVIDER_TOKEN="replace-with-local-value"
VITE_AI_PROVIDER_TOKEN="replace-with-local-value"

# Storage / database
VITE_DATABASE_URL="replace-with-local-value"
VITE_PUBLIC_CLIENT_TOKEN="replace-with-local-value"

# Publishing / analytics
VITE_PUBLISHING_CLIENT_ID="replace-with-local-value"
VITE_ANALYTICS_TOKEN="replace-with-local-value"
